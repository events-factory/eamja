# SmartEvent registration backend.
# Copy to .env.local and fill in. Defaults live in lib/smartevent.ts.
SMARTEVENT_API_URL=https://app.smartevent.rw/Api
SMARTEVENT_EVENT_CODE=

# Mastercard hosted checkout script used by the embedded payment modal

# Smartbookings hotel booking (accommodation page). Defaults live in
# lib/smartbookings.ts.
SMARTBOOKINGS_API_URL=https://smartbookings.rw
SMARTBOOKINGS_EVENT_CODE=
# Mastercard gateways Smartbookings sessions are looked up on (live, then
# test). Only needed if Smartbookings moves to another gateway host.
# SMARTBOOKINGS_GATEWAY_HOSTS=https://ap-gateway.mastercard.com,https://test-gateway.mastercard.com
